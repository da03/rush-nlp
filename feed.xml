---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom">
  <channel>
    <title>Yuntian Deng — News</title>
    <description>Research news and updates from Yuntian Deng at the University of Waterloo.</description>
    <link>{{ '/' | absolute_url | xml_escape }}</link>
    <language>en</language>
    <atom:link href="{{ '/feed.xml' | absolute_url | xml_escape }}" rel="self" type="application/rss+xml"/>
    {% for item in site.data.news limit:20 %}
      {% assign item_url = '/' | absolute_url | append: '#' | append: item.id %}
      <item>
        <title>{{ item.title | truncate: 160 | xml_escape }}</title>
        <description>{{ item.content | replace: 'href="#', 'href="https://yuntiandeng.com/#' | replace: 'src="images/', 'src="https://yuntiandeng.com/images/' | xml_escape }}</description>
        <pubDate>{{ item.date | date_to_rfc822 }}</pubDate>
        <link>{{ item_url | xml_escape }}</link>
        <guid isPermaLink="true">{{ item_url | xml_escape }}</guid>
      </item>
    {% endfor %}
  </channel>
</rss>
