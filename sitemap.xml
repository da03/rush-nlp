---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/zh/' | absolute_url | xml_escape }}</loc><lastmod>2026-11-11</lastmod></url>
  {% for language in site.data.homepage_languages %}{% unless language.id == 'en' or language.id == 'zh' %}
  {% assign homepage = site.pages | where: 'homepage_locale', language.id | first %}
  <url><loc>{{ language.path | absolute_url | xml_escape }}</loc>{% if homepage.last_modified_at %}<lastmod>{{ homepage.last_modified_at | date: '%Y-%m-%d' }}</lastmod>{% endif %}</url>
  {% endunless %}{% endfor %}
  <url><loc>{{ '/group/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/demos/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/talks/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/teaching/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/publications/' | absolute_url | xml_escape }}</loc></url>
  {% for research_page in site.data.methods.meta.static_pages %}
  <url><loc>{{ research_page.path | prepend: '/research/' | absolute_url | xml_escape }}</loc><lastmod>{{ research_page.updated_at | xml_escape }}</lastmod></url>
  {% endfor %}
  {% for guide in site.data.methods.guides %}
  <url><loc>{{ guide.id | prepend: '/research/' | append: '/' | absolute_url | xml_escape }}</loc><lastmod>{{ guide.updated_at | xml_escape }}</lastmod></url>
  {% endfor %}
  {% for paper in site.data.methods.papers %}
  <url><loc>{{ paper.id | prepend: '/research/papers/' | append: '/' | absolute_url | xml_escape }}</loc><lastmod>{{ paper.updated_at | xml_escape }}</lastmod></url>
  {% endfor %}
  {% for chinese_page in site.data.methods.zh.meta.pages %}
  <url><loc>{{ chinese_page.path | prepend: '/research/zh/' | absolute_url | xml_escape }}</loc><lastmod>{{ chinese_page.updated_at | xml_escape }}</lastmod></url>
  {% endfor %}
  <url><loc>{{ '/cv.pdf' | absolute_url | xml_escape }}</loc></url>
  {% for course in site.data.teaching.teaching %}
  <url><loc>{{ course.course_url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% assign talk_urls = site.data.talks.talks | map: 'url' | compact | uniq %}
  {% for talk_url in talk_urls %}
  {% assign first_character = talk_url | slice: 0 %}
  {% if first_character == '/' %}
  <url><loc>{{ talk_url | absolute_url | xml_escape }}</loc></url>
  {% endif %}
  {% endfor %}
  {% for hub_page in site.pages %}
  {% assign prefix = hub_page.url | slice: 0, 10 %}
  {% assign suffix = hub_page.url | slice: -1, 1 %}
  {% if prefix == '/wildchat/' and suffix == '/' %}
  {% assign content_updated = site.data.wildchat.page_updates[hub_page.url] %}
  <url><loc>{{ hub_page.url | absolute_url | xml_escape }}</loc>{% if content_updated %}<lastmod>{{ content_updated | xml_escape }}</lastmod>{% endif %}</url>
  {% endif %}
  {% endfor %}
</urlset>
