---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  <url><loc>{{ '/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/group/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/demos/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/talks/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/teaching/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/publications/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/research/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/research/papers/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/research/data/' | absolute_url | xml_escape }}</loc></url>
  <url><loc>{{ '/research/about/' | absolute_url | xml_escape }}</loc></url>
  {% for guide in site.data.methods.guides %}
  <url><loc>{{ guide.id | prepend: '/research/' | append: '/' | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% for paper in site.data.methods.papers %}
  <url><loc>{{ paper.id | prepend: '/research/papers/' | append: '/' | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  <url><loc>{{ '/cv.pdf' | absolute_url | xml_escape }}</loc></url>
  {% for course in site.data.teaching.teaching %}
  <url><loc>{{ course.course_url | absolute_url | xml_escape }}</loc></url>
  {% endfor %}
  {% assign talk_urls = site.data.talks.talks | map: 'url' | compact | uniq %}
  {% for talk_url in talk_urls %}
  {% assign first_character = talk_url | slice: 0 %}
  {% if first_character == '/' %}
  <url><loc>{{ talk_url | absolute_url | xml_escape }}</loc></url>
  {% endif %}
  {% endfor %}
  {% for hub_page in site.pages %}
  {% assign prefix = hub_page.url | slice: 0, 10 %}
  {% assign suffix = hub_page.url | slice: -1, 1 %}
  {% if prefix == '/wildchat/' and suffix == '/' %}
  <url><loc>{{ hub_page.url | absolute_url | xml_escape }}</loc><lastmod>{{ site.data.wildchat.meta.updated_at }}</lastmod></url>
  {% endif %}
  {% endfor %}
</urlset>
